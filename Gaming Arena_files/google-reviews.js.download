// Google Reviews Slider Component
class GoogleReviewsSlider {
    constructor() {
        this.currentSlide = 0;
        this.autoSlideInterval = null;
        this.reviews = this.getReviewsData();
        this.init();
    }

    init() {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                setTimeout(() => this.createReviewsSection(), 500);
            });
        } else {
            setTimeout(() => this.createReviewsSection(), 500);
        }
    }

    // Sample Google Reviews Data
    getReviewsData() {
        return [
            {
                id: 1,
                name: "Arjun Sharma",
                avatar: "AS",
                rating: 5,
                date: "2 weeks ago",
                text: "Amazing gaming experience! Best gaming lounge in Ambala. High-end PCs, comfortable seating, and great atmosphere. Staff is very helpful and friendly. Highly recommended for PUBG and Free Fire tournaments!",
                platform: "Google"
            },
            {
                id: 2,
                name: "Priya Singh",
                avatar: "PS",
                rating: 5,
                date: "1 month ago", 
                text: "Visited with friends for a gaming session. The setup is incredible - latest games, fast internet, and AC environment. Pricing is reasonable too. Will definitely come back for more gaming sessions!",
                platform: "Google"
            },
            {
                id: 3,
                name: "Rohit Kumar",
                avatar: "RK",
                rating: 4,
                date: "3 weeks ago",
                text: "Great place for competitive gaming. Participated in their FIFA tournament and had a blast. Good crowd, professional setup, and fair gameplay. Only suggestion is to extend operating hours on weekends.",
                platform: "Google"
            },
            {
                id: 4,
                name: "Sneha Gupta",
                avatar: "SG",
                rating: 5,
                date: "1 week ago",
                text: "Perfect spot for gaming enthusiasts! Clean environment, latest gaming peripherals, and excellent customer service. My brother celebrated his birthday here and everyone loved it. Booking process is also very smooth.",
                platform: "Google"
            },
            {
                id: 5,
                name: "Vikash Yadav",
                avatar: "VY",
                rating: 5,
                date: "2 months ago",
                text: "Been coming here regularly for Call of Duty sessions. The gaming PCs are top-notch with high refresh rate monitors. Great for both casual and competitive gaming. The staff knows their games well and provides good recommendations.",
                platform: "Google"
            },
            {
                id: 6,
                name: "Anjali Verma",
                avatar: "AV",
                rating: 4,
                date: "3 days ago",
                text: "Excellent gaming lounge with modern facilities. Tried Valorant and PUBG here - smooth gameplay with no lag. The ambiance is perfect for gaming. Snacks and beverages are also available. Definitely worth visiting!",
                platform: "Google"
            },
            {
                id: 7,
                name: "Deepak Chauhan",
                avatar: "DC",
                rating: 5,
                date: "1 month ago",
                text: "Outstanding gaming experience! Organized a team building event here and it was fantastic. Professional setup, helpful staff, and great gaming environment. All our employees enjoyed the session. Highly recommended for corporate events too!",
                platform: "Google"
            },
            {
                id: 8,
                name: "Ravi Patel",
                avatar: "RP",
                rating: 5,
                date: "2 weeks ago",
                text: "Best gaming cafe in the city! Love the variety of games available. From battle royale to racing games, everything runs smoothly. The chairs are comfortable for long gaming sessions. Great value for money!",
                platform: "Google"
            }
        ];
    }

    createReviewsSection() {
        // First try to find footer and add reviews before it
        const footer = document.querySelector('footer') || 
                      document.querySelector('.footer') ||
                      document.querySelector('[class*="footer"]') ||
                      document.querySelector('[data-footer]');
        
        if (footer) {
            console.log('Footer found, adding reviews before footer');
            footer.parentNode.insertBefore(this.createReviewsHTML(), footer);
        } else {
            // If no footer, try to find location section
            const locationSection = document.querySelector('.location-section') || 
                                   document.querySelector('[data-location]') ||
                                   document.querySelector('.map-container') ||
                                   this.findMapContainer();
            
            if (locationSection) {
                console.log('Location section found, adding reviews before location');
                locationSection.parentNode.insertBefore(this.createReviewsHTML(), locationSection);
            } else {
                // Last resort - add before last script tag or at end of body
                console.log('No footer or location found, adding to end of body');
                const scripts = document.querySelectorAll('script');
                const lastScript = scripts[scripts.length - 1];
                if (lastScript && lastScript.parentNode === document.body) {
                    lastScript.parentNode.insertBefore(this.createReviewsHTML(), lastScript);
                } else {
                    document.body.appendChild(this.createReviewsHTML());
                }
            }
        }

        // Initialize slider functionality with delay to ensure DOM is ready
        setTimeout(() => {
            this.initializeSlider();
        }, 100);
    }

    findMapContainer() {
        // Try to find map container by common selectors
        const mapSelectors = [
            'iframe[src*="google.com/maps"]',
            'iframe[src*="maps.google"]',
            '.google-map',
            '.map-embed',
            '[data-map]',
            '.location-map',
            '.map-container',
            '.map-section',
            '[class*="map"]',
            '[id*="map"]'
        ];

        for (const selector of mapSelectors) {
            const element = document.querySelector(selector);
            if (element) {
                console.log('Map container found with selector:', selector);
                return element.closest('section') || element.parentElement;
            }
        }
        
        // Also try to find by text content
        const allSections = document.querySelectorAll('section, div[class*="section"], div[id*="section"]');
        for (const section of allSections) {
            const text = section.textContent.toLowerCase();
            if (text.includes('location') || text.includes('address') || text.includes('visit') || text.includes('map')) {
                console.log('Location section found by text content');
                return section;
            }
        }
        
        console.log('No map/location container found');
        return null;
    }

    createReviewsHTML() {
        const section = document.createElement('section');
        section.className = 'reviews-section';
        section.innerHTML = `
            <div class="reviews-container">
                <div class="reviews-header">
                    <h2 class="reviews-title">
                        <span class="google-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                        </span>
                        Google Reviews
                        <div class="rating-summary">
                            <div class="stars">
                                ${'★'.repeat(5)}
                            </div>
                            <span class="rating-text">5.0 out of 5</span>
                        </div>
                    </h2>
                    <p class="reviews-subtitle">What our customers say about Gaming Arena</p>
                </div>

                <div class="reviews-slider">
                    <div class="reviews-track" id="reviewsTrack">
                        ${this.reviews.map(review => this.createReviewCard(review)).join('')}
                    </div>
                    
                    <div class="slider-controls">
                        <button class="slider-btn prev-btn" id="prevBtn">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
                            </svg>
                        </button>
                        <button class="slider-btn next-btn" id="nextBtn">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
                            </svg>
                        </button>
                    </div>

                    <div class="slider-dots" id="sliderDots">
                        ${this.reviews.map((_, index) => 
                            `<button class="dot ${index === 0 ? 'active' : ''}" data-slide="${index}"></button>`
                        ).join('')}
                    </div>
                </div>

                <div class="reviews-footer">
                    <a href="https://maps.app.goo.gl/bvyRR2bvFqcBVVuC7" 
                       target="_blank" 
                       class="google-reviews-link">
                        <span class="google-icon-small">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                        </span>
                        View all reviews on Google
                    </a>
                </div>
            </div>
        `;

        return section;
    }

    createReviewCard(review) {
        return `
            <div class="review-card">
                <div class="review-header">
                    <div class="reviewer-info">
                        <div class="reviewer-avatar">
                            ${review.avatar}
                        </div>
                        <div class="reviewer-details">
                            <h4 class="reviewer-name">${review.name}</h4>
                            <div class="review-meta">
                                <div class="review-rating">
                                    ${'★'.repeat(review.rating)}${'☆'.repeat(5 - review.rating)}
                                </div>
                                <span class="review-date">${review.date}</span>
                            </div>
                        </div>
                    </div>
                    <div class="platform-badge">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                    </div>
                </div>
                <div class="review-content">
                    <p class="review-text">${review.text}</p>
                </div>
            </div>
        `;
    }

    initializeSlider() {
        const track = document.getElementById('reviewsTrack');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const dots = document.querySelectorAll('.dot');

        if (!track) {
            console.warn('Reviews track not found. Retrying...');
            setTimeout(() => this.initializeSlider(), 500);
            return;
        }

        console.log('Initializing slider with', this.reviews.length, 'reviews');

        // Button event listeners
        if (prevBtn) {
            prevBtn.addEventListener('click', (e) => {
                e.preventDefault();
                this.prevSlide();
            });
        }
        
        if (nextBtn) {
            nextBtn.addEventListener('click', (e) => {
                e.preventDefault();
                this.nextSlide();
            });
        }

        // Dot navigation
        dots.forEach((dot, index) => {
            dot.addEventListener('click', (e) => {
                e.preventDefault();
                this.goToSlide(index);
            });
        });

        // Touch/swipe support
        this.addTouchSupport(track);

        // Set initial slide
        this.updateSlider();

        // Auto-slide
        this.startAutoSlide();

        // Pause auto-slide on hover
        const slider = document.querySelector('.reviews-slider');
        if (slider) {
            slider.addEventListener('mouseenter', () => this.stopAutoSlide());
            slider.addEventListener('mouseleave', () => this.startAutoSlide());
        }

        console.log('Slider initialized successfully!');
    }

    nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.reviews.length;
        this.updateSlider();
    }

    prevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.reviews.length) % this.reviews.length;
        this.updateSlider();
    }

    goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
    }

    updateSlider() {
        const track = document.getElementById('reviewsTrack');
        const dots = document.querySelectorAll('.dot');

        if (!track) {
            console.warn('Track not found for slider update');
            return;
        }

        // Calculate slide width based on screen size
        const slideWidth = this.getSlideWidth();
        const offset = -this.currentSlide * slideWidth;

        console.log('Updating slider - Current slide:', this.currentSlide, 'Offset:', offset + '%');

        track.style.transform = `translateX(${offset}%)`;

        // Update dots
        dots.forEach((dot, index) => {
            dot.classList.toggle('active', index === this.currentSlide);
        });
    }

    getSlideWidth() {
        const screenWidth = window.innerWidth;
        if (screenWidth >= 1200) return 33.333; // 3 cards
        if (screenWidth >= 768) return 50;      // 2 cards
        return 100;                             // 1 card
    }

    addTouchSupport(track) {
        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        track.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            isDragging = true;
            this.stopAutoSlide();
        });

        track.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            currentX = e.touches[0].clientX;
        });

        track.addEventListener('touchend', () => {
            if (!isDragging) return;
            isDragging = false;

            const diff = startX - currentX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) {
                    this.nextSlide();
                } else {
                    this.prevSlide();
                }
            }

            this.startAutoSlide();
        });
    }

    startAutoSlide() {
        this.stopAutoSlide();
        this.autoSlideInterval = setInterval(() => {
            this.nextSlide();
        }, 5000); // 5 seconds
    }

    stopAutoSlide() {
        if (this.autoSlideInterval) {
            clearInterval(this.autoSlideInterval);
            this.autoSlideInterval = null;
        }
    }

    // Handle window resize
    handleResize() {
        this.updateSlider();
    }
}

// Initialize reviews slider
const reviewsSlider = new GoogleReviewsSlider();

// Make it globally accessible for debugging
window.reviewsSlider = reviewsSlider;

// Handle window resize
window.addEventListener('resize', () => {
    if (reviewsSlider.handleResize) {
        reviewsSlider.handleResize();
    }
});

// Debug logging
console.log('🎮 Google Reviews Slider loaded');
console.log('📊 Slider instance:', reviewsSlider);

// Export for use in other scripts
window.GoogleReviewsSlider = GoogleReviewsSlider;